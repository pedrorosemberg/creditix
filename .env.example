# Copie este arquivo para .env.local (desenvolvimento) e nunca faça commit
# do arquivo preenchido com valores reais. Em produção/homologação, configure
# estes valores como secrets na Vercel (ou no seu orquestrador, se self-hosted).

# ---------------------------------------------------------------------------
# Supabase (self-hosted ou Supabase Cloud — mesma API em ambos os casos)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca exponha a service role key ao cliente — só é lida em código server-side.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Segredo compartilhado para autenticar chamadas do cron mensal de lembretes
# (gere com: openssl rand -hex 32)
CRON_SECRET=

# ---------------------------------------------------------------------------
# E-mail transacional (Resend) — usado para lembretes mensais de vencimento
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Creditix <lembretes@creditix.metadax.com.br>
# Segredo "whsec_..." mostrado pelo Resend ao criar o webhook (painel do
# Resend -> Webhooks -> aponte para <APP_URL>/api/webhooks/resend).
RESEND_WEBHOOK_API_KEY=

# ---------------------------------------------------------------------------
# Análise por IA — server-side apenas, nunca chamado do navegador
# ---------------------------------------------------------------------------
# Deixe em branco para usar o modelo local embutido ("local") — funciona
# bem em self-hosted (Docker, servidor próprio). NÃO funciona na Vercel:
# o ambiente serverless não consegue carregar o binário nativo que esse
# motor precisa (confirmado em produção — "libonnxruntime.so.1: cannot
# open shared object file"). Em deploys na Vercel, use "ollama" apontando
# para um servidor Ollama seu (ver docs/OLLAMA_SERVIDOR_GRATUITO.md para
# subir um de graça na Oracle Cloud) — nenhum dado sai da sua
# infraestrutura de qualquer forma. "gemini" (API em nuvem do Google)
# também existe mas fica desligado por padrão de propósito — dados do
# usuário sairiam para os servidores deles; só é usado se você definir
# isso aqui explicitamente.
AI_PROVIDER=

# Necessário apenas se AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Necessário só se o OLLAMA_HOST for um servidor exposto na internet
# (não uma rede privada/localhost) — o Ollama não tem autenticação
# própria, então isso evita que qualquer pessoa use seu servidor. Ver
# docs/OLLAMA_SERVIDOR_GRATUITO.md (VM própria, ex.: Oracle Cloud).
OLLAMA_BASIC_AUTH_USER=
OLLAMA_BASIC_AUTH_PASSWORD=

# Alternativa ao Basic Auth acima, para quando o OLLAMA_HOST é um serviço
# do Google Cloud Run que não pode ficar público (política "Domain
# Restricted Sharing" da organização) — ver docs/OLLAMA_CLOUD_RUN_GRATUITO.md.
# Cole aqui o JSON inteiro (uma linha só) da chave de uma conta de serviço
# com papel `roles/run.invoker` no serviço. Se ambos estiverem definidos,
# esta variável tem prioridade sobre o Basic Auth.
OLLAMA_GOOGLE_SERVICE_ACCOUNT_JSON=

# Necessário apenas se AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Opcional para o modelo local embutido (padrão): não é necessário para o
# download dos pesos funcionar, mas reduz o risco de rate limit anônimo da
# Hugging Face em builds muito frequentes. Token gratuito, só de leitura,
# gerado em https://huggingface.co/settings/tokens (escopo "Read" basta).
# IMPORTANTE: isso NÃO envia nenhum dado de usuário para a Hugging Face —
# serve só para autenticar o download de arquivos públicos (pesos do
# modelo) durante o build; nenhuma chamada é feita em runtime.
HF_TOKEN=

# Usado pelo modelo local embutido (padrão).
LOCAL_MODEL_ID=onnx-community/Qwen2.5-0.5B-Instruct
LOCAL_MODEL_MAX_NEW_TOKENS=350
LOCAL_MODEL_TIMEOUT_MS=55000
