# Domínio que aponta para o IP público do servidor. Se você não tiver um
# domínio próprio, use "<ip-publico-com-tracos>.nip.io" (ex.: IP
# 129.146.10.5 vira 129-146-10-5.nip.io) — resolve automaticamente para o
# IP embutido no nome, sem precisar comprar nada nem configurar DNS. O
# Caddy usa isso para emitir um certificado HTTPS de verdade (Let's
# Encrypt) sozinho.
DOMINIO=

# Usuário para o Basic Auth exigido pelo Caddy antes de chegar no Ollama.
BASIC_AUTH_USER=creditix

# Hash bcrypt da senha (não a senha em texto puro). Gere com:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'SUA_SENHA_AQUI'
BASIC_AUTH_HASH=
