# Copie para docker/.env e preencha antes de "docker compose up".
# Gere os segredos com: node ../scripts/generate-jwt-keys.mjs

# --- Segredos gerados pelo script acima ---
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
CRON_SECRET=

# --- URLs ---
# URL pública onde a aplicação Next.js fica acessível (navegador do usuário).
APP_URL=http://localhost:3000
# URL pública do gateway (Auth + REST). Em produção, aponte para um subdomínio
# próprio (ex.: https://api.creditix.metadax.com.br) atrás de HTTPS.
GATEWAY_URL=http://localhost:8000
GATEWAY_PORT=8000
APP_PORT=3000
OLLAMA_PORT=11434

# --- Auth ---
# Em produção, prefira "false" e configure SMTP para exigir confirmação de e-mail.
GOTRUE_MAILER_AUTOCONFIRM=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@example.com

# --- E-mail (Resend, para lembretes mensais) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Creditix <lembretes@creditix.metadax.com.br>

# --- IA ---
AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
